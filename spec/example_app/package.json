{
  "name": "terrazzo-example-app",
  "private": true,
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": ">=11.10.0",
      "onFail": "error"
    }
  },
  "scripts": {
    "audit": "npm audit --audit-level=moderate",
    "build": "node esbuild.config.mjs && npx @tailwindcss/cli -i app/assets/stylesheets/admin.css -o app/assets/builds/admin.css --minify",
    "build:css": "npx @tailwindcss/cli -i app/assets/stylesheets/admin.css -o app/assets/builds/admin.css --minify",
    "build:watch": "node esbuild.config.mjs --watch & npx @tailwindcss/cli -i app/assets/stylesheets/admin.css -o app/assets/builds/admin.css --watch"
  },
  "dependencies": {
    "@radix-ui/react-avatar": "1.1.11",
    "@radix-ui/react-dialog": "1.1.15",
    "@radix-ui/react-dropdown-menu": "2.1.16",
    "@radix-ui/react-label": "2.1.8",
    "@radix-ui/react-popover": "1.1.15",
    "@radix-ui/react-select": "2.2.6",
    "@radix-ui/react-separator": "1.1.8",
    "@radix-ui/react-slot": "1.2.4",
    "@radix-ui/react-tooltip": "1.2.8",
    "@reduxjs/toolkit": "2.11.2",
    "@thoughtbot/superglue": "1.0.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "0.344.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-redux": "9.2.0",
    "terrazzo": "file:../../npm",
    "tailwind-merge": "2.6.1"
  },
  "devDependencies": {
    "@tailwindcss/cli": "4.2.1",
    "esbuild": "0.28.1",
    "tailwindcss": "4.2.1"
  }
}
