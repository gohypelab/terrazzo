json.pageTitle @page.page_title

show_field_json = ->(json, field) do
  json.attribute field.attribute.to_s
  json.label dashboard.attribute_label(field.attribute, :show)
  json.hint dashboard.attribute_hint(field.attribute, :show)
  json.fieldType field.field_type
  json.value field.serialize_value(:show)
  json.options field.serializable_options

  if field.class.associative? && field.data.present?
    if field.is_a?(Terrazzo::Field::HasMany)
      render_actions = field.options.fetch(:render_actions, true)

      json.hasManyRowExtras(field.page_records.each_with_object({}) do |record, hash|
        extras = { showPath: collection_action_path(record, :show) }
        extras[:collectionItemActions] = collection_item_actions(record) if render_actions
        hash[record.id.to_s] = extras
      end)

      json.paginationPaths has_many_pagination_paths(field, @resource)
    else
      json.showPath collection_action_path(field.data, :show)
    end
  end
end

json.attributes do
  @page.grouped_attributes.flat_map { |g| g[:fields] }.each do |field|
    json.set!(field.attribute.to_s) do
      show_field_json.call(json, field)
    end
  end
end

json.attributeGroups do
  json.array! @page.grouped_attributes do |group|
    json.name group[:name]
    json.attributeKeys group[:fields].map { |f| f.attribute.to_s }
  end
end

json.layoutActions Array(dashboard.layout_actions(:show, self, resource: @resource))
json.editPath route_exists?(:edit) && authorized_action?(@resource, :edit) ? terrazzo_resource_member_path(@resource, action: :edit) : nil
json.deletePath route_exists?(:destroy) && authorized_action?(@resource, :destroy) ? terrazzo_resource_member_path(@resource, action: :destroy) : nil
json.indexPath begin
  url_for(controller: controller_path, action: :index, only_path: true)
rescue ActionController::UrlGenerationError
  nil
end
json.resourceName resource_name
json.pluralResourceName resource_name.pluralize
