{
  "name": "terrazzo",
  "version": "0.7.3",
  "description": "React admin utilities for Terrazzo Rails gem",
  "keywords": [
    "administrate",
    "admin",
    "rails",
    "react",
    "superglue"
  ],
  "homepage": "https://gohypelab.github.io/terrazzo/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gohypelab/terrazzo.git",
    "directory": "npm"
  },
  "bugs": {
    "url": "https://github.com/gohypelab/terrazzo/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": ">=11.10.0",
      "onFail": "error"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./fields": {
      "import": "./dist/fields.js",
      "require": "./dist/fields.cjs"
    },
    "./ui": {
      "import": "./dist/ui.js",
      "require": "./dist/ui.cjs"
    },
    "./components": {
      "import": "./dist/components.js",
      "require": "./dist/components.cjs"
    },
    "./pages": {
      "import": "./dist/pages.js",
      "require": "./dist/pages.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "prepare": "tsup",
    "build": "tsup",
    "dev": "tsup --watch",
    "check": "npm audit --audit-level=moderate && npm run lint && npm test && npm run test:exports",
    "test": "vitest run",
    "test:exports": "npm run build && node scripts/check-package-exports.mjs && node scripts/check-package-contents.mjs",
    "test:watch": "vitest",
    "lint": "eslint src/",
    "prepack": "npm run check"
  },
  "peerDependencies": {
    "@radix-ui/react-avatar": ">=1.0.0",
    "@radix-ui/react-dialog": ">=1.0.0",
    "@radix-ui/react-dropdown-menu": ">=2.0.0",
    "@radix-ui/react-label": ">=2.0.0",
    "@radix-ui/react-popover": ">=1.0.0",
    "@radix-ui/react-select": ">=2.0.0",
    "@radix-ui/react-separator": ">=1.0.0",
    "@radix-ui/react-slot": ">=1.0.0",
    "@radix-ui/react-tooltip": ">=1.0.0",
    "@reduxjs/toolkit": ">=1.9.0",
    "@thoughtbot/superglue": ">=1.0.0",
    "class-variance-authority": ">=0.7.0",
    "lucide-react": ">=0.300.0",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0",
    "react-redux": ">=8.0.0"
  },
  "dependencies": {
    "clsx": "2.1.1",
    "tailwind-merge": "2.6.1"
  },
  "overrides": {
    "esbuild": "0.28.1"
  },
  "devDependencies": {
    "@radix-ui/react-avatar": "1.1.11",
    "@radix-ui/react-dialog": "1.1.15",
    "@radix-ui/react-dropdown-menu": "2.1.16",
    "@radix-ui/react-label": "2.1.8",
    "@radix-ui/react-popover": "1.1.15",
    "@radix-ui/react-select": "2.2.6",
    "@radix-ui/react-separator": "1.1.8",
    "@radix-ui/react-slot": "1.2.4",
    "@radix-ui/react-tooltip": "1.2.8",
    "@reduxjs/toolkit": "2.11.2",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "14.3.1",
    "@thoughtbot/superglue": "1.0.3",
    "class-variance-authority": "0.7.1",
    "eslint": "9.39.4",
    "eslint-plugin-react": "7.37.5",
    "jsdom": "24.1.3",
    "lucide-react": "0.300.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-redux": "9.2.0",
    "tsup": "8.5.1",
    "typescript": "5.9.3",
    "vitest": "3.2.6"
  },
  "license": "MIT"
}
